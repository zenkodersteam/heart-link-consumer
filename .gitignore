node_modules/
.DS_Store

# Local Claude Code state: dev-server launch config, scheduled-task locks.
# Per-machine tooling, not project source.
.claude/
.env
.env.local
.expo/
dist/
.next/
out/
*.log

# TypeScript incremental build state — churns on every build
*.tsbuildinfo

# Copied out of node_modules by scripts/copy-pdf-worker.mjs on every dev/build,
# so it is a build artefact rather than source - 1.2 MB that would otherwise be
# committed and go stale against the installed pdfjs-dist.
apps/admin/public/pdf.worker.min.mjs

# The Android native project is generated, not committed - `npm run android`,
# `npm run apk` and every EAS build run prebuild first. iOS is committed because
# its project carries hand-made state (signing, Pods); Android's does not.
apps/mobile/android/
