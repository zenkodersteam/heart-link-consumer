{
  "name": "@heartlink/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "android": "expo run:android",
    "android:only": "expo run:android --no-bundler",
    "android:emulator": "node scripts/android-emulator.mjs",
    "android:logs": "adb logcat -s ReactNative:V ReactNativeJS:V",
    "apk": "node scripts/android-apk.mjs release",
    "apk:debug": "node scripts/android-apk.mjs debug",
    "ios": "expo run:ios",
    "ios:only": "expo run:ios --no-bundler",
    "prebuild": "LANG=en_US.UTF-8 expo prebuild --platform ios",
    "prebuild:android": "LANG=en_US.UTF-8 expo prebuild --platform android",
    "prebuild:clean": "LANG=en_US.UTF-8 expo prebuild --platform ios --clean",
    "pods": "cd ios && LANG=en_US.UTF-8 pod install",
    "typecheck": "tsc --noEmit",
    "deps:check": "expo install --check"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@expo-google-fonts/bree-serif": "^0.2.3",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^14.0.0",
    "@heartlink/consumer-api": "*",
    "@heartlink/consumer-content": "*",
    "@heartlink/design-tokens": "*",
    "@heartlink/domain": "*",
    "expo": "~52.0.0",
    "expo-application": "~6.0.0",
    "expo-asset": "~11.0.0",
    "expo-auth-session": "~6.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.0",
    "expo-image": "~2.0.0",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.2",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "~4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "babel-preset-expo": "~12.0.0",
    "eas-cli": "^23.2.0",
    "typescript": "^5.4.0"
  }
}
