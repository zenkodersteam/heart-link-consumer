# Consumer app env vars. Expo requires the EXPO_PUBLIC_ prefix to expose to the client.
# Copy to .env (gitignored) and fill in values.

# Clerk publishable key. Use the same instance as admin-web.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Railway API base URL. The HeartLink NestJS API.
# Must be set explicitly per environment - do not rely on stale hardcoded fallbacks.
#
# Against a local API, use this machine's LAN address (`ipconfig getifaddr en0`),
# not localhost: on a physical device localhost is the phone. The LAN address
# also works from the simulator and the browser, so one value covers all three.
EXPO_PUBLIC_API_BASE_URL=https://api-production-8a07.up.railway.app

# Public support inbox shown in the consumer Support screen.
EXPO_PUBLIC_SUPPORT_EMAIL=support@heartlinkconnect.com
