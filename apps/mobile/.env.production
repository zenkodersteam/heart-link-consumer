# Loaded only when Expo bundles in production mode - which is exactly what the
# Xcode Release/Archive build does. Keeps .env free for local development, so
# archiving needs no edit-before, edit-after dance that someone will forget.
EXPO_PUBLIC_API_BASE_URL=https://api.heartlinkconnect.zenkoders.com
EXPO_PUBLIC_PREVIEW_BYPASS_AUTH=false
EXPO_PUBLIC_SUPPORT_EMAIL=support@heartlinkconnect.com
