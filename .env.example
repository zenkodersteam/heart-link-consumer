# Consumer app env vars. Expo requires the EXPO_PUBLIC_ prefix to expose to the client.
# Copy to .env (gitignored) and fill in values.

# Clerk publishable key. Use the same instance as admin-web.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Railway API base URL. The HeartLink NestJS API.
EXPO_PUBLIC_API_BASE_URL=https://heart-link-api.up.railway.app
